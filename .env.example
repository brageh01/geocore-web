# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Demo mode. Default is ON when unset — set to exactly "false" for the live path.
# ON:  fires come from the committed fixture in lib/demo/, AQI is simulated, the
#      camera idles and auto-rotates, and nothing calls FIRMS or OpenAQ.
# OFF: fires are fetched per viewport from /api/fires and AQI from /api/aqi.
# Temporary — this flag and everything under lib/demo/ get deleted together.
NEXT_PUBLIC_DEMO_MODE=true

# Cesium Ion access token. Supplies the whole globe surface: Cesium World
# Terrain (asset 1) and Bing Aerial imagery (asset 2). Create at
# https://ion.cesium.com/tokens — needs assets:read. Exposed to the client
# bundle, because Cesium requests both directly from the page.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# NASA FIRMS MAP_KEY for the active-fire CSV API. Request at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/ — server-side only.
NASA_FIRMS_API_KEY=

# OpenAQ v3 API key, sent as the X-API-Key header. Register at
# https://explore.openaq.org/register — server-side only.
OPENAQ_API_KEY=
